# Groq (xAI) API
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_MODEL=openai/gpt-oss-120b

# PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/botdb
SPRING_DATASOURCE_USERNAME=botuser
SPRING_DATASOURCE_PASSWORD=botpass

# Memory service
MEMORY_SERVICE_TOKEN=local-dev-token

# Frontend API URL (relative for same-origin; set to your backend URL if different)
VITE_API_URL=

# JWT (required): the backend refuses to start without a strong secret.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-generate-a-random-secret
JWT_EXPIRATION_MS=86400000
